generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(uuid())
  privyId             String?   @unique @map("privy_id")
  email               String?
  tier                String    @default("starter")
  saidPubkey          String?   @map("said_pubkey")
  privyWalletAddress  String?   @map("privy_wallet_address")
  billingStatus       String    @default("none") @map("billing_status") // none, trial, active, grace, paused, cancelled
  billingMode         String    @default("all_inclusive") @map("billing_mode") // all_inclusive, byok
  trialEndsAt         DateTime? @map("trial_ends_at")
  nextBillingDate     DateTime? @map("next_billing_date")
  lastPaymentAt       DateTime? @map("last_payment_at")
  lastPaymentTx       String?   @map("last_payment_tx")
  paymentToken        String    @default("USDC") @map("payment_token") // USDC, SAID, SOL
  monthlyAmountUsd    Float?    @map("monthly_amount_usd")
  graceStartedAt      DateTime? @map("grace_started_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  agents              Agent[]
  payments            Payment[]

  @@map("users")
}

model Payment {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  agentId       String?  @map("agent_id")
  amountUsd     Float    @map("amount_usd")
  token         String   // USDC, SAID, SOL
  tokenAmount   Float    @map("token_amount")
  txSignature   String?  @map("tx_signature")
  status        String   // pending, success, failed
  type          String   // subscription, topup, trial_start
  createdAt     DateTime @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id])
  agent Agent? @relation(fields: [agentId], references: [id])

  @@map("payments")
}

model Agent {
  id                   String   @id @default(uuid())
  userId               String   @map("user_id")
  name                 String
  flyMachineId         String?  @map("fly_machine_id")
  flyAppName           String?  @map("fly_app_name")
  status               String   @default("creating")
  tier                 String   @default("starter")
  walletAddress        String?  @map("wallet_address")
  saidPda              String?  @map("said_pda")
  saidRegistrationTx   String?  @map("said_registration_tx")
  metaplexAsset        String?  @map("metaplex_asset")
  metaplexUri          String?  @map("metaplex_uri")
  snsDomain            String?  @map("sns_domain")
  fundingStatus        String?  @default("pending") @map("funding_status")
  fundingAmountUsdc    Float?   @map("funding_amount_usdc")
  fundingSignature     String?  @map("funding_signature")
  fundingLastError     String?  @map("funding_last_error")
  fundedAt             DateTime? @map("funded_at")
  programMd            String?  @map("program_md")
  config               String?
  gatewayTokenHash     String?  @map("gateway_token_hash")
  gatewayToken         String?  @map("gateway_token")
  aiCreditsUsed        Float    @default(0) @map("ai_credits_used")
  aiCreditsLimit       Float    @default(5) @map("ai_credits_limit")
  openrouterKeyHash    String?  @map("openrouter_key_hash")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user     User       @relation(fields: [userId], references: [id])
  activity Activity[]
  payments Payment[]

  @@map("agents")
}

model Activity {
  id        Int      @id @default(autoincrement())
  agentId   String   @map("agent_id")
  type      String
  data      String?
  createdAt DateTime @default(now()) @map("created_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("activity")
}
